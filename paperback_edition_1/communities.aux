\@writefile{lof}{\contentsline {figure}{\numberline {6.1}{\ignorespaces \textbf  {Communities emerge from local rules.} (a) A network grown by a local rule settles into dense communities (two here, one dark gray, one white) joined by only a few links. (b) Shuffling the links at random while keeping every node's number of connections destroys the communities --- so the structure was the work of the rule, not of the degrees alone.}}{51}{figure.6.1}\protected@file@percent }
\newlabel{fig:com-rewire}{{6.1}{51}{\textbf {Communities emerge from local rules.} (a) A network grown by a local rule settles into dense communities (two here, one dark gray, one white) joined by only a few links. (b) Shuffling the links at random while keeping every node's number of connections destroys the communities --- so the structure was the work of the rule, not of the degrees alone}{figure.6.1}{}}
