\@writefile{lof}{\contentsline {figure}{\numberline {6.3}{\ignorespaces \textbf  {Communities in a duplication--split network.} An instance of the duplication--split model $\mathrm  {DS}(n{=}50,q{=}0.3)$. Two communities (dark gray and white) again emerge --- even though this rule builds no triangles at all, so the network is far less cliquish than the local-search one of Figure\nobreakspace  {}\ref {fig:com-ls}.}}{54}{figure.6.3}\protected@file@percent }
\newlabel{fig:com-ds}{{6.3}{54}{\textbf {Communities in a duplication--split network.} An instance of the duplication--split model $\mathrm {DS}(n{=}50,q{=}0.3)$. Two communities (dark gray and white) again emerge --- even though this rule builds no triangles at all, so the network is far less cliquish than the local-search one of Figure~\ref {fig:com-ls}}{figure.6.3}{}}
