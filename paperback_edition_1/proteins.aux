\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces \textbf  {Duplication and divergence.} (a) A gene duplication adds a copy $i'$ (gray) wired to every interaction partner of the ancestor $i$, plus a link between the twins when the protein is self-interacting. (b) Divergence then prunes the now-redundant interactions (dotted), each partner kept by only one twin, so the copies drift apart.}}{32}{figure.4.1}\protected@file@percent }
\newlabel{fig:dup-diverge}{{4.1}{32}{\textbf {Duplication and divergence.} (a) A gene duplication adds a copy $i'$ (gray) wired to every interaction partner of the ancestor $i$, plus a link between the twins when the protein is self-interacting. (b) Divergence then prunes the now-redundant interactions (dotted), each partner kept by only one twin, so the copies drift apart}{figure.4.1}{}}
