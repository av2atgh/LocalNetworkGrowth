\@writefile{toc}{\contentsline {paragraph}{Degree and degree distribution.}{3}{section*.3}\protected@file@percent }
\newlabel{eq:intro-powerlaw}{{1.1}{3}{Degree and degree distribution}{equation.1.2.1}{}}
\citation{watts1998}
\@writefile{lof}{\contentsline {figure}{\numberline {1.1}{\ignorespaces \textbf  {Degree.} A node's degree is simply its number of links. Drawn here with node size growing with degree: a few hubs (such as the central one, $k=7$) carry many links, while most nodes have only one or two. That imbalance --- many small nodes, a few giant hubs --- is the hallmark of a scale-free network.}}{4}{figure.1.1}\protected@file@percent }
\newlabel{fig:intro-degree}{{1.1}{4}{\textbf {Degree.} A node's degree is simply its number of links. Drawn here with node size growing with degree: a few hubs (such as the central one, $k=7$) carry many links, while most nodes have only one or two. That imbalance --- many small nodes, a few giant hubs --- is the hallmark of a scale-free network}{figure.1.1}{}}
\@writefile{toc}{\contentsline {paragraph}{Clustering coefficient.}{4}{section*.4}\protected@file@percent }
\newlabel{eq:intro-clustering}{{1.2}{4}{Clustering coefficient}{equation.1.2.2}{}}
\citation{pastorsatorras2001}
\@writefile{lof}{\contentsline {figure}{\numberline {1.2}{\ignorespaces \textbf  {Clustering coefficient.} The clustering of the central node (gray) is the fraction of its neighbor pairs that are themselves linked. (a) Four of the six neighbor pairs are linked (the bold links), so $c\approx 0.67$ --- a cliquish neighborhood. (b) No neighbors are linked to each other, so $c=0$.}}{5}{figure.1.2}\protected@file@percent }
\newlabel{fig:intro-clustering}{{1.2}{5}{\textbf {Clustering coefficient.} The clustering of the central node (gray) is the fraction of its neighbor pairs that are themselves linked. (a) Four of the six neighbor pairs are linked (the bold links), so $c\approx 0.67$ --- a cliquish neighborhood. (b) No neighbors are linked to each other, so $c=0$}{figure.1.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.3}{\ignorespaces \textbf  {Distance.} The distance between two nodes is the number of links on the shortest route between them. The shortest route from $A$ to $B$ here is three hops (in bold); the lower route is longer. In real networks these shortest distances stay small even as the network grows --- the small-world effect.}}{5}{figure.1.3}\protected@file@percent }
\newlabel{fig:intro-distance}{{1.3}{5}{\textbf {Distance.} The distance between two nodes is the number of links on the shortest route between them. The shortest route from $A$ to $B$ here is three hops (in bold); the lower route is longer. In real networks these shortest distances stay small even as the network grows --- the small-world effect}{figure.1.3}{}}
\@writefile{toc}{\contentsline {paragraph}{Average distance.}{5}{section*.5}\protected@file@percent }
\citation{newman2002}
\@writefile{toc}{\contentsline {paragraph}{Degree correlations.}{6}{section*.6}\protected@file@percent }
\newlabel{eq:intro-knn}{{1.3}{6}{Degree correlations}{equation.1.2.3}{}}
\newlabel{eq:intro-knn-unc}{{1.4}{6}{Degree correlations}{equation.1.2.4}{}}
\citation{ravasz2002,ravasz2003}
\@writefile{lof}{\contentsline {figure}{\numberline {1.4}{\ignorespaces \textbf  {Degree correlations.} (a) In an \emph  {assortative} network, hubs tend to link to other hubs (``birds of a feather''). (b) In a \emph  {disassortative} one, hubs avoid each other and link instead to low-degree nodes (``opposites attract''). Social networks lean assortative; technological and biological ones, disassortative.}}{7}{figure.1.4}\protected@file@percent }
\newlabel{fig:intro-correlations}{{1.4}{7}{\textbf {Degree correlations.} (a) In an \emph {assortative} network, hubs tend to link to other hubs (``birds of a feather''). (b) In a \emph {disassortative} one, hubs avoid each other and link instead to low-degree nodes (``opposites attract''). Social networks lean assortative; technological and biological ones, disassortative}{figure.1.4}{}}
\@writefile{toc}{\contentsline {paragraph}{Clustering hierarchy.}{7}{section*.7}\protected@file@percent }
\newlabel{eq:intro-hierarchy}{{1.5}{7}{Clustering hierarchy}{equation.1.2.5}{}}
\citation{soffer2005}
\citation{barabasi1999}
\@writefile{lof}{\contentsline {figure}{\numberline {1.5}{\ignorespaces \textbf  {Clustering hierarchy.} Low-degree nodes sit inside tight clusters where everyone is connected (high clustering, the dark triangles), while a hub bridges many such clusters. The hub's own neighbors --- one drawn from each cluster --- do not know each other, so the hub itself has low clustering. Cliquishness therefore falls as degree rises.}}{8}{figure.1.5}\protected@file@percent }
\newlabel{fig:intro-hierarchy}{{1.5}{8}{\textbf {Clustering hierarchy.} Low-degree nodes sit inside tight clusters where everyone is connected (high clustering, the dark triangles), while a hub bridges many such clusters. The hub's own neighbors --- one drawn from each cluster --- do not know each other, so the hub itself has low clustering. Cliquishness therefore falls as degree rises}{figure.1.5}{}}
